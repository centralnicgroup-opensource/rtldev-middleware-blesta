<?xml version="1.0"?>
<ruleset name="PSR2 Transitional">
    <!-- What to scan by default, so the standard can be run with no arguments -->
    <file>cnr.php</file>
    <file>lib</file>
    <file>apis</file>
    <file>config</file>
    <file>language</file>
    <file>views</file>
    <file>tests</file>

    <!-- Third party code is not ours to restyle. The release stages a copy of
         the module under components/ and vendors dependencies under apis/vendor. -->
    <exclude-pattern>apis/vendor/*</exclude-pattern>
    <exclude-pattern>components/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>

    <!-- Every file should end with a new line except views -->
    <rule ref="Generic.Files.EndFileNewline">
        <exclude-pattern>*.pdt</exclude-pattern>
    </rule>

    <!-- Line ending characters should all be \n -->
    <rule ref="Generic.Files.LineEndings" />

    <!-- Exclude template and language files from the line-too-long PSR2 rule -->
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude-pattern>*.pdt</exclude-pattern>
        <exclude-pattern>/language/*.php</exclude-pattern>
    </rule>

    <!-- Require PSR2 Rules except for namespaces -->
    <rule ref="PSR2">
        <exclude name="PSR1.Classes.ClassDeclaration"/>
    </rule>
</ruleset>

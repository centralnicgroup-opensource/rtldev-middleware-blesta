{
  "name": "centralnicgroup-opensource/blesta-cnr",
  "description": "CentralNic Reseller registrar module for Blesta",
  "type": "blesta-module",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "centralnic-reseller/php-sdk": "^33.0.3"
  },
  "authors": [
    {
      "name": "Kai Schwarz",
      "homepage": "https://github.com/KaiSchwarz-cnic"
    },
    {
      "name": "Sebastian Vassiliou",
      "homepage": "https://github.com/SebastianVassiliou-cnic"
    },
    {
      "name": "Asif Nawaz",
      "homepage": "https://github.com/AsifNawaz-cnic"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "vendor-dir": "apis/vendor"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0",
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": [
      "phpunit --colors=always"
    ],
    "codecheck": [
      "phpcs -q -n -s --colors"
    ],
    "codefix": [
      "phpcbf -q"
    ]
  }
}
